{
  "name": "antersurf",
  "version": "27.0.0",
  "description": "Privacy-first browser",
  "author": {
    "name": "PlanetOfOSes",
    "email": "planetofoses989@gmail.com"
  },
  "main": "dist/main.js",
  "scripts": {
    "start": "npm run build:dev && electron . --no-sandbox",
    "build:dev": "webpack --mode development",
    "build:prod": "webpack --mode production",
    "dist": "electron-builder",
    "package": "python3 scripts/package_release.py"
  },
  "build": {
    "appId": "com.nexunfog.antersurf",
    "productName": "AnterSurf",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "static/**/*"
    ],
    "linux": {
      "target": [
        "deb",
        "rpm"
      ],
      "category": "Network",
      "icon": "static/logo.png"
    },
    "win": {
      "target": "nsis",
      "icon": "static/logo.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "static/logo.png"
    },
    "dmg": {
      "artifactName": "AnterSurf-${version}.dmg"
    },
    "portable": {
      "artifactName": "AnterSurf-${version}.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AnterSurf",
      "artifactName": "AnterSurf-Setup-${version}.exe",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true
    },
    "deb": {
      "artifactName": "antersurf_${version}_amd64.deb"
    },
    "rpm": {
      "artifactName": "antersurf-${version}.x86_64.rpm"
    }
  },
  "devDependencies": {
    "copy-webpack-plugin": "^14.0.0",
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3",
    "html-webpack-plugin": "^5.6.3",
    "webpack": "^5.108.4",
    "webpack-cli": "^6.0.1"
  },
  "allowScripts": {
    "electron@35.7.5": true,
    "lzma-native@8.0.6": true
  },
  "dependencies": {
    "electron-updater": "^6.3.0",
    "lzma-native": "^8.0.6",
    "sql.js": "^1.14.1"
  }
}
